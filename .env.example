# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# SMTP (existing transactional mail, src/lib/mail.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gemini (existing)
GEMINI_API_KEY=

# Bulk email — Microsoft Graph (new)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Approved From addresses for campaigns (comma-separated → the composer's From dropdown).
# IMPORTANT: every address here must ALSO be in the Azure "BulkEmailSenders" security
# group (Application Access Policy), or Graph rejects the send with 403.
# Single sender:
#   EMAIL_SENDER_ADDRESSES=alex.smith@opelsoft.com
# Multiple senders:
#   EMAIL_SENDER_ADDRESSES=alex.smith@opelsoft.com,harsh@opelsoft.com,careers@opelsoft.com
EMAIL_SENDER_ADDRESSES=alex.smith@opelsoft.com
EMAIL_DEFAULT_REPLY_TO=harsh@opelsoft.com
EMAIL_DAILY_CAP=800
EMAIL_SENDER_BACKEND=graph        # graph | acs (Phase 2)
EMAIL_DRAIN_SECRET=               # generate: openssl rand -hex 32 — guards /api/campaigns/drain
APP_BASE_URL=                     # deployed URL (unsubscribe links + pg_cron target), local: http://localhost:3000
